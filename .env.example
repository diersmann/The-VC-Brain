COMPOSE_PROJECT_NAME=vc-brain
POSTGRES_DB=vc_brain
POSTGRES_USER=vc_brain
POSTGRES_PASSWORD=vc_brain_dev

# Backend settings use the APP_ prefix so local runs and Docker use the same names.
APP_NAME=The VC Brain API
APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+asyncpg://vc_brain:vc_brain_dev@localhost:5432/vc_brain
APP_REDIS_URL=redis://localhost:6379/0

# LLM provider
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o
APP_LLM_MAX_TOKENS=4096
APP_LLM_TEMPERATURE=0.3

# CORS (comma-separated origins for production)
APP_CORS_ORIGINS=http://localhost:5173

# MinIO / S3-compatible object storage (defaults work for local dev)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=vc-brain-snapshots
APP_MINIO_SECURE=false

# Source API keys (optional for local dev — connectors work without them)
APP_GITHUB_TOKEN=
APP_PRODUCTHUNT_TOKEN=
APP_TAVILY_API_KEY=
APP_YOUTUBE_API_KEY=

# Collection thresholds and limits
APP_SIGNAL_THRESHOLD=0.45
APP_COLLECTION_CONCURRENCY=4
APP_TAVILY_MONTHLY_BUDGET=1000
APP_ARXIV_MIN_CITATIONS=10
APP_ARXIV_COAUTHOR_CAP=20
APP_WEBSITE_SEED_CAP=10
APP_WEBSITE_MAX_BYTES=10485760
APP_PERSONS_CREATED_PER_DAY=200

# Inbound pitch safety (production requires a scanner command, e.g. clamscan --no-summary)
APP_UPLOAD_MAX_BYTES=26214400
APP_UPLOAD_MAX_PAGES=100
APP_UPLOAD_MAX_TEXT_CHARS=50000
APP_UPLOAD_MALWARE_SCANNER=
APP_UPLOAD_SCAN_TIMEOUT_SECONDS=30

# Scoring agents
APP_AGENT_MODEL=gpt-4o
APP_AGENT_CONCURRENCY=2
APP_AGENT_MAX_TOKENS=1000
APP_AGENT_MONTHLY_BUDGET=100

# Embeddings
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_CONCURRENCY=4

# Automated deal lifecycle
APP_CONTACT_THRESHOLD=0.65
APP_PIPELINE_STUCK_AFTER_MINUTES=30
APP_PIPELINE_BATCH_SIZE=5
